# Reduz o contexto de build e estabiliza o cache do COPY.
# (paths relativos a M-RCNN/, que e o contexto de build)

# Historico git do repo matterport (~138MB, muda a cada operacao git)
**/.git
**/.gitignore

# Pesos baixados e checkpoints (gerados em runtime, nao vao na imagem)
**/*.h5
Mask_RCNN/logs/

# Material de documentacao do repo (nao usado no treino)
Mask_RCNN/assets/
Mask_RCNN/images/
**/*.ipynb

# Caches Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Config local
.env
